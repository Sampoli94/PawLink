# PawLink Environment Variables

# Server Port (default 5000)
PORT=5000

# PostgreSQL Connection String
# Compatible with Vercel Postgres, Supabase, Neon, or local PostgreSQL.
# For Vercel Postgres, this is automatically set as POSTGRES_URL.
# For Supabase, copy the "Connection String" (URI / Pooled) from Project Settings -> Database.
# Example: postgres://postgres.yourproject:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# JWT Secret for authentication tokens
JWT_SECRET=pawlink-secret-key-12345
